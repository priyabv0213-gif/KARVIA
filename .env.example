# KARVIA Production Mobile App Environment Configuration

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=karvia-artisan.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=karvia-artisan
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=karvia-artisan.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=102938475612
EXPO_PUBLIC_FIREBASE_APP_ID=1:102938475612:android:9876543210abcdef
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# AI Services Configuration (Backend / Gemini API Gateway)
EXPO_PUBLIC_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateway (Razorpay / UPI)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_karvia_mock_key
EXPO_PUBLIC_PAYMENT_CURRENCY=INR

# 3D & AR Configuration
EXPO_PUBLIC_ENABLE_AR_CORE=true
EXPO_PUBLIC_3D_ASSET_CDN=https://cdn.karvia.crafts.org/3d

# Platform Settings
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_DEFAULT_LOCALE=en
EXPO_PUBLIC_ENABLE_OFFLINE_SYNC=true
